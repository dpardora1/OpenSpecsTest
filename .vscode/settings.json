{
  // Agent observability (plan §9, decisions D-06/D-07). Requires the local stack:
  //   docker compose -f observability/compose.yaml up -d
  "github.copilot.chat.otel.enabled": true,
  "github.copilot.chat.otel.exporterType": "otlp-http",
  "github.copilot.chat.otel.otlpEndpoint": "http://localhost:4318",
  // Demo environment: capture full prompts, responses and tool arguments (secrets are masked by the collector).
  "github.copilot.chat.otel.captureContent": true,
  // Local SQLite copy of the spans, exportable with "Chat: Export Agent Traces DB".
  "github.copilot.chat.otel.dbSpanExporter.enabled": true
}
